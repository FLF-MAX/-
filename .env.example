# ============================================
# LAAP 环境配置模板
# ============================================
# 复制为 .env 并填入实际值
# Windows: copy .env.example .env
# Linux:   cp .env.example .env
#
# 所有带 <...> 的占位符必须替换为你的实际值。
# 本项目不会提交 .env 文件，请放心存放密钥。

# ---------- 路径 (可选 —— 自动检测通常足够) ----------
# LAAP 项目根目录。留空时从脚本位置自动推断。
LAAP_ROOT=

# Aris 大脑目录。留空时默认为 $LAAP_ROOT/aris_brain。
ARIS_BRAIN_ROOT=

# 运行时状态/数据库目录。留空时默认为 $ARIS_BRAIN_ROOT/state。
LAAP_STATE_DIR=

# 本地模型存放目录。留空时默认为项目根同级的 laap_models/。
LAAP_MODELS_DIR=

# Hermes Agent 根目录（包含 run_agent.py）。
# 留空时依次检测 pip 包、$LAAP_ROOT/hermes-agent-main、$HOME/.hermes/hermes-agent。
HERMES_ROOT=

# Hermes venv 中的 Python 解释器路径（用于 update_hermes_config.py）
HERMES_VENV_PYTHON=

# Hermes 网关锁文件路径（可选，用于自检）
HERMES_GATEWAY_LOCK=

# 日志目录（可选，用于 watchdog）
ARIS_LOG_DIR=

# ---------- 飞书 Bot ----------
FEISHU_APP_ID=cli_your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here
FEISHU_CHAT_ID=your_chat_id_here

# ---------- DeepSeek API ----------
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# ---------- 小智 MCP ----------
XIAOZHI_MCP_TOKEN=your_xiaozhi_mcp_token_here

# ---------- PSI 治理 / 宪法签名 ----------
CONSTITUTION_SIGNING_KEY=your_ed25519_private_key_here

# ---------- LAAP API / Hermes 集成 ----------
# LAAP Brain API 监听地址（Hermes MCP 会连接这里）
LAAP_API_BASE=http://localhost:11546
LAAP_PORT=11546

# ---------- 内部服务端口 ----------
QUANTUM_PORT=11520
QUANTUM_DIM=1024
AO_PORT=11530
QLG_PORT=11522
SYNC_PORT=11525
PSI_ARIS_PORT=11551
PSI_AO_PORT=11553

# ---------- 记忆 / 认知 ----------
MEMORY_CAPACITY=10000
MEMORY_MAX_WORKING=50

# ---------- 日志 ----------
LAAP_LOG_LEVEL=INFO
